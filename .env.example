# Build-time client configuration for a Supabase project.
# This repository's source has safe public URL/publishable-key defaults in src/supabase.js.
# Override only when using another project; never put service_role/secret keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
