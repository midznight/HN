{
  "name": "our-space-android",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run build:css && vite --host 0.0.0.0",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./src/tailwind.css -o ./src/tailwind.generated.css --minify",
    "build": "npm run build:css && vite build",
    "test": "node --test",
    "android:prepare": "npx cap add android && node scripts/prepare-android.mjs && npx cap sync android",
    "android:debug": "npm run build && npm run android:prepare && cd android && ./gradlew --no-daemon assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "lucide": "1.59.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "tailwindcss": "3.4.19",
    "vite": "8.3.4"
  }
}
